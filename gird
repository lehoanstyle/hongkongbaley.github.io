import cv2, mediapipe as mp
mp_face_mesh = mp.solutions.face_mesh
face_mesh = mp_face_mesh.FaceMesh(static_image_mode=True)
img = cv2.imread("your_face.jpg")
res = face_mesh.process(cv2.cvtColor(img, cv2.COLOR_BGR2RGB))
# 绘制网格并保存
annot = img.copy()
for conn in mp_face_mesh.FACEMESH_TESSELATION:
    cv2.line(annot, (int(res.multi_face_landmarks[0].landmark[conn[0]].x*img.shape[1]),
                     int(res.multi_face_landmarks[0].landmark[conn[0]].y*img.shape[0])),
             (int(res.multi_face_landmarks[0].landmark[conn[1]].x*img.shape[1]),
              int(res.multi_face_landmarks[0].landmark[conn[1]].y*img.shape[0])), (0,255,0), 1)
cv2.imwrite("face_mesh.png", annot)